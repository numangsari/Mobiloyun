<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the procedural sprites (and a mock of a board) to PNG so the art can be reviewed without Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../JellyMold/Assets/JellyMold/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../JellyMold/Assets/JellyMold/Scripts/Procedural/**/*.cs" Link="Procedural/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
