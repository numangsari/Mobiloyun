<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the Unity project's pure C# Core and its EditMode tests outside Unity.
    LangVersion 9 matches the C# version Unity 6 supports, so code that builds here
    does not rely on newer language features.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>JellyMold.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../JellyMold/Assets/JellyMold/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../JellyMold/Assets/JellyMold/Tests/EditMode/**/*.cs" Link="Tests/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../JellyMold/Assets/JellyMold/Resources/Levels/*.json" Link="Levels/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
